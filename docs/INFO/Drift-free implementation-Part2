class AtomicParquetWriter:
  """
    Cross-platform atomic Parquet writer safe for Windows 11 NTFS and Ubuntu Linux.
    Writes to a same-directory temp file, flushes OS buffers, closes handles,
    and performs an atomic os.replace() with transient lock retry for Windows.
    """

  def __init__(
      self,
      base_dir: str | Path,
      compression: str = "zstd",
      compression_level: int = 3,
      max_retries: int = 5,
      retry_delay_sec: float = 0.05,
  ) -> None:
    self.base_dir = Path(base_dir)
    self.base_dir.mkdir(parents=True, exist_ok=True)
    self.compression = compression
    self.compression_level = compression_level
    self.max_retries = max_retries
    self.retry_delay_sec = retry_delay_sec

  def write_records(
      self,
      records: list[dict[str, Any]],
      relative_path: str | Path,
      schema: dict[str, pl.DataType] | None = None,
  ) -> Path | None:
    if not records:
      return None

    df = pl.DataFrame(records, schema=schema)
    return self.write_dataframe(df, relative_path)

  def write_dataframe(
      self,
      df: pl.DataFrame,
      relative_path: str | Path,
  ) -> Path | None:
    if df.is_empty():
      return None

    target_path = self.base_dir / relative_path
    target_path.parent.mkdir(parents=True, exist_ok=True)

    # Temp file MUST reside in the exact same directory/volume for atomic os.replace()
    tmp_path = target_path.with_name(
        f".{target_path.name}.{os.getpid()}.{uuid.uuid4().hex[:8]}.tmp"
    )

    try:
      arrow_table: pa.Table = df.to_arrow()
      with open(tmp_path, "wb") as f:
        pq.write_table(
            arrow_table,
            f,
            compression=self.compression,
            compression_level=self.compression_level,
            use_dictionary=True,
            write_statistics=True,
        )
        f.flush()
        os.fsync(f.fileno())

      # File handle is strictly closed before replace (critical on Windows NTFS)
      self._atomic_replace_with_retry(tmp_path, target_path)
      return target_path

    except Exception:
      if tmp_path.exists():
        try:
          tmp_path.unlink()
        except OSError:
          pass
      raise

  def _atomic_replace_with_retry(self, src: Path, dst: Path) -> None:
    """
        Retries os.replace() if Windows Defender or Search Indexer briefly holds
        a read handle on the newly flushed .tmp file.
        """
    for attempt in range(self.max_retries):
      try:
        os.replace(src, dst)
        return
      except PermissionError:
        if attempt == self.max_retries - 1:
          raise
        time.sleep(self.retry_delay_sec * (2**attempt))


class RedisStreamBridge:
  """
    Multi-process IPC bus over Redis:
    - Bronze Ticks: Redis Streams (XADD with approximate MAXLEN) + Consumer Groups
    - Gold State: Atomic Redis Hashes/Strings with strict staleness TTL checks
    """

  def __init__(
      self,
      redis_url: str = "redis://127.0.0.1:6379/0",
      stream_maxlen: int = 500_000,
  ) -> None:
    self.client = redis.Redis.from_url(
        redis_url,
        decode_responses=False,
        socket_timeout=2.0,
        socket_connect_timeout=2.0,
        retry_on_timeout=True,
    )
    self.stream_maxlen = stream_maxlen

  # --- BRONZE: STREAM PRODUCER (kite_ingestor) ---
  def publish_tick_batch(
      self,
      stream_key: str,
      ticks: list[dict[str, Any]],
  ) -> None:
    if not ticks:
      return

    ingested_ns = time.time_ns()
    pipe = self.client.pipeline(transaction=False)
    for tick in ticks:
      payload = orjson.dumps(tick)
      pipe.xadd(
          stream_key,
          {b"p": payload, b"ts_ns": str(ingested_ns).encode()},
          maxlen=self.stream_maxlen,
          approximate=True,
      )
    pipe.execute()

  # --- SILVER: STREAM CONSUMER (silver_normalizer) ---
  def ensure_consumer_group(self, stream_key: str, group_name: str) -> None:
    try:
      self.client.xgroup_create(
          stream_key, group_name, id="0", mkstream=True
      )
    except redis.exceptions.ResponseError as exc:
      if "BUSYGROUP" not in str(exc):
        raise

  def consume_ticks(
      self,
      stream_key: str,
      group_name: str,
      consumer_name: str,
      count: int = 500,
      block_ms: int = 100,
  ) -> list[tuple[bytes, dict[str, Any], int]]:
    """
        Reads unacknowledged ticks from the stream.
        Returns list of (message_id, decoded_tick_dict, ingested_ts_ns).
        """
    response = self.client.xreadgroup(
        groupname=group_name,
        consumername=consumer_name,
        streams={stream_key: ">"},
        count=count,
        block=block_ms,
    )
    if not response:
      return []

    parsed: list[tuple[bytes, dict[str, Any], int]] = []
    for _stream, messages in response:
      for msg_id, fields in messages:
        tick = orjson.loads(fields[b"p"])
        ts_ns = int(fields[b"ts_ns"])
        parsed.append((msg_id, tick, ts_ns))
    return parsed

  def ack_ticks(
      self, stream_key: str, group_name: str, msg_ids: list[bytes]
  ) -> None:
    if msg_ids:
      self.client.xack(stream_key, group_name, *msg_ids)

  # --- GOLD: ATOMIC STATE PUBLISHER & STALENESS-GUARDED READER ---
  def publish_gold_artifact(
      self,
      artifact_key: str,
      data: dict[str, Any],
      source_tick_utc_ms: int,
      expire_sec: int = 3600,
  ) -> None:
    envelope = {
        "published_at_ms": int(time.time() * 1000),
        "source_tick_ms": source_tick_utc_ms,
        "data": data,
    }
    self.client.set(artifact_key, orjson.dumps(envelope), ex=expire_sec)

  def read_gold_artifact(
      self,
      artifact_key: str,
      max_age_ms: int = 2000,
  ) -> tuple[str, dict[str, Any] | None]:
    """
        Reads Gold state and enforces circuit-breaker staleness checks.
        Returns status ('FRESH', 'DEGRADED', 'STALE', 'MISSING') and payload.
        """
    raw = self.client.get(artifact_key)
    if raw is None:
      return "MISSING", None

    envelope = orjson.loads(raw)
    now_ms = int(time.time() * 1000)
    age_ms = now_ms - envelope["source_tick_ms"]

    if age_ms <= max_age_ms:
      return "FRESH", envelope["data"]
    if age_ms <= max_age_ms * 3:
      return "DEGRADED", envelope["data"]
    return "STALE", None
