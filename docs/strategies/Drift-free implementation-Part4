def run_quack_storage_server(
    data_root: str, quack_uri: str, quack_token: str
) -> None:
  """
    Process 0/Core: Owns medallion.duckdb in read/write mode and exposes
    the DuckDB 2.0 Quack protocol on localhost for concurrent worker access.
    """
