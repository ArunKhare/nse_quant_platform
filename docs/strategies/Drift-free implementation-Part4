class PlatformOrchestrator:

  def __init__(self) -> None:
    self.data_root = os.getenv(
        "TRADING_DATA_ROOT",
        r"C:\trading_platform" if os.name == "nt" else "/srv/trading_platform",
    )
    self.quack_uri = os.getenv("QUACK_URI", "quack:127.0.0.1:9494")
    self.quack_token = os.getenv("QUACK_TOKEN", "local_secret")
    self._shutdown = False
    self._processes: dict[str, mp.Process] = {}
    self._specs: dict[str, tuple[Callable[..., None], tuple[object, ...]]] = {
        "quack_server": (
            run_quack_storage_server,
            (self.data_root, self.quack_uri, self.quack_token),
        ),
        "bronze_ingestor": (run_bronze_ingestor, ()),
        "silver_gold_worker": (run_silver_and_gold_pipeline, ()),
        "execution_router": (run_execution_router, ()),
    }

  def _start_worker(self, name: str) -> None:
    target, args = self._specs[name]
    proc = mp.Process(target=target, args=args, name=name, daemon=False)
    proc.start()
    self._processes[name] = proc
    logger.info("worker_started", worker=name, pid=proc.pid)

  def start_all(self) -> None:
    # Start Quack server first and allow 1.5s bind time before clients attach
    self._start_worker("quack_server")
    time.sleep(1.5)

    for name in ("bronze_ingestor", "silver_gold_worker", "execution_router"):
      self._start_worker(name)

  def supervise(self) -> None:
    self.start_all()
    while not self._shutdown:
      for name, proc in list(self._processes.items()):
        if not proc.is_alive() and not self._shutdown:
          logger.error(
              "worker_crashed_restarting",
              worker=name,
              exitcode=proc.exitcode,
          )
          time.sleep(2.0)
          self._start_worker(name)
      time.sleep(2.0)

  def stop_all(self) -> None:
    if self._shutdown:
      return
    self._shutdown = True
    logger.info("stopping_all_platform_workers")

    # Shut down execution first, Quack server last
    shutdown_order = (
        "execution_router",
        "silver_gold_worker",
        "bronze_ingestor",
        "quack_server",
    )
    for name in shutdown_order:
      proc = self._processes.get(name)
      if proc and proc.is_alive():
        proc.terminate()
        proc.join(timeout=5.0)
        if proc.is_alive():
          logger.warning("force_killing_worker", worker=name)
          proc.kill()
        logger.info("worker_stopped", worker=name)


