from __future__ import annotations

from datetime import datetime, timezone
import os
from pathlib import Path
import queue
import signal
import threading
import time
from typing import Any

from kiteconnect import KiteConnect, KiteTicker
import polars as pl
from pydantic_settings import BaseSettings, SettingsConfigDict
import structlog
from tenacity import retry, stop_after_attempt, wait_exponential

from storage_bridge import AtomicParquetWriter

logger = structlog.get_logger(__name__)


class KiteIngestorSettings(BaseSettings):
  model_config = SettingsConfigDict(env_file=".env", extra="ignore")

  kite_api_key: str
  kite_access_token: str
  trading_data_root: Path = Path(
      r"C:\trading_platform" if os.name == "nt" else "/srv/trading_platform"
  )
  flush_interval_sec: int = 60


class KiteBronzeIngestor:
  """
    Manages up to 3 concurrent KiteTicker WebSocket connections (9,000 tokens max),
    captures raw ticks with monotonic ingestion timestamps, and flushes atomic
    Bronze Parquet partitions every `flush_interval_sec`.
    """

  def __init__(self, settings: KiteIngestorSettings | None = None) -> None:
    self.settings = settings or KiteIngestorSettings()
    self.data_dir = self.settings.trading_data_root / "data"
    self.writer = AtomicParquetWriter(base_dir=self.data_dir)
    self.kite = KiteConnect(api_key=self.settings.kite_api_key)
    self.kite.set_access_token(self.settings.kite_access_token)

    self._tick_queue: queue.Queue[dict[str, Any]] = queue.Queue(maxsize=250_000)
    self._stop_event = threading.Event()
    self._tickers: list[KiteTicker] = []

  @retry(
      stop=stop_after_attempt(5),
      wait=wait_exponential(multiplier=1, min=2, max=30),
      reraise=True,
  )
  def sync_daily_instruments(self) -> pl.DataFrame:
    """
        Fetches daily NSE & NFO instrument master dumps at 08:30 IST and writes
        them atomically to Bronze so token-to-strike/expiry mapping is point-in-time.
        """
    today_utc = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    logger.info("fetching_kite_instruments", trade_date=today_utc)

    nse_list = self.kite.instruments("NSE")
    nfo_list = self.kite.instruments("NFO")
    combined = nse_list + nfo_list

    records = [
        {
            "instrument_token": int(row["instrument_token"]),
            "exchange_token": int(row["exchange_token"]),
            "tradingsymbol": str(row["tradingsymbol"]),
            "name": str(row.get("name") or ""),
            "strike": float(row.get("strike") or 0.0),
            "expiry": str(row.get("expiry") or ""),
            "instrument_type": str(row.get("instrument_type") or ""),
            "segment": str(row.get("segment") or ""),
            "lot_size": int(row.get("lot_size") or 1),
            "tick_size": float(row.get("tick_size") or 0.05),
        }
        for row in combined
    ]

    df = pl.DataFrame(records)
    self.writer.write_dataframe(
        df, relative_path=f"bronze/{today_utc}/instruments.parquet"
    )
    logger.info("instruments_synced", count=df.height)
    return df

  def _spawn_socket_worker(
      self,
      socket_id: int,
      tokens: list[int],
      mode: str,
  ) -> None:
    """
        Runs an isolated KiteTicker WebSocket loop for up to 3,000 tokens.
        """
    if not tokens:
      return
    if len(tokens) > 3000:
      raise ValueError(
          f"Socket {socket_id} exceeded Kite 3,000 token limit: {len(tokens)}"
      )

    kws = KiteTicker(
        api_key=self.settings.kite_api_key,
        access_token=self.settings.kite_access_token,
        reconnect=True,
        reconnect_max_tries=50,
        reconnect_max_delay=30,
    )
    self._tickers.append(kws)

    def on_connect(ws: Any, _response: Any) -> None:
      logger.info(
          "kite_ws_connected",
          socket_id=socket_id,
          token_count=len(tokens),
          mode=mode,
      )
      ws.subscribe(tokens)
      ws.set_mode(mode, tokens)

    def on_ticks(_ws: Any, ticks: list[dict[str, Any]]) -> None:
      ingested_ms = int(time.time() * 1000)
      for t in ticks:
        ex_ts = t.get("exchange_timestamp")
        ex_ts_ms = (
            int(ex_ts.timestamp() * 1000)
            if isinstance(ex_ts, datetime)
            else ingested_ms
        )
        depth = t.get("depth") or {}
        best_bid = (
            depth["buy"][0]["price"] if depth.get("buy") else 0.0
        )
        best_ask = (
            depth["sell"][0]["price"] if depth.get("sell") else 0.0
        )

        record = {
            "socket_id": socket_id,
            "instrument_token": int(t["instrument_token"]),
            "last_price": float(t.get("last_price") or 0.0),
            "volume": int(t.get("volume_traded") or 0),
            "oi": int(t.get("oi") or 0),
            "total_buy_qty": int(t.get("total_buy_quantity") or 0),
            "total_sell_qty": int(t.get("total_sell_quantity") or 0),
            "best_bid": float(best_bid),
            "best_ask": float(best_ask),
            "exchange_ts_ms": ex_ts_ms,
            "ingested_ts_ms": ingested_ms,
        }
        try:
          self._tick_queue.put_nowait(record)
        except queue.Full:
          logger.error("bronze_tick_queue_overflow", socket_id=socket_id)

    def on_error(_ws: Any, code: int, reason: str) -> None:
      logger.error(
          "kite_ws_error", socket_id=socket_id, code=code, reason=reason
      )

    def on_close(_ws: Any, code: int, reason: str) -> None:
      logger.warning(
          "kite_ws_closed", socket_id=socket_id, code=code, reason=reason
      )

    kws.on_connect = on_connect
    kws.on_ticks = on_ticks
    kws.on_error = on_error
    kws.on_close = on_close

    # Blocking call inside dedicated daemon thread
    kws.connect(threaded=False)

  def _flush_loop(self) -> None:
    """
        Drains the in-memory tick queue every `flush_interval_sec` and writes
        an immutable Parquet file atomically to `data/bronze/YYYY-MM-DD/`.
        """
    while not self._stop_event.is_set():
      self._stop_event.wait(self.settings.flush_interval_sec)
      self._drain_and_write()

  def _drain_and_write(self) -> None:
    batch: list[dict[str, Any]] = []
    while True:
      try:
        batch.append(self._tick_queue.get_nowait())
      except queue.Empty:
        break

    if not batch:
      return

    now_utc = datetime.now(timezone.utc)
    day_str = now_utc.strftime("%Y-%m-%d")
    ts_str = now_utc.strftime("%H%M%S_%f")[:10]
    rel_path = f"bronze/{day_str}/ticks_{ts_str}.parquet"

    saved = self.writer.write_records(batch, relative_path=rel_path)
    logger.info("bronze_batch_flushed", rows=len(batch), path=str(saved))

  def start(
      self,
      socket_1_index_tokens: list[int],
      socket_2_stock_opt_tokens: list[int],
      socket_3_nifty500_tokens: list[int],
  ) -> None:
    """
        Launches 3 WebSocket threads + 1 atomic disk flusher thread.
        """
    socket_configs = (
        (1, socket_1_index_tokens, KiteTicker.MODE_FULL),
        (2, socket_2_stock_opt_tokens, KiteTicker.MODE_FULL),
        (3, socket_3_nifty500_tokens, KiteTicker.MODE_QUOTE),
    )

    for sock_id, tokens, mode in socket_configs:
      t = threading.Thread(
          target=self._spawn_socket_worker,
          args=(sock_id, tokens, mode),
          name=f"kite-ws-{sock_id}",
          daemon=True,
      )
      t.start()

    flusher = threading.Thread(
        target=self._flush_loop,
        name="bronze-parquet-flusher",
        daemon=True,
    )
    flusher.start()
    logger.info("kite_bronze_ingestor_running")

  def stop(self) -> None:
    logger.info("shutting_down_ingestor")
    self._stop_event.set()
    for kws in self._tickers:
      try:
        kws.close()
      except Exception:
        pass
    self._drain_and_write()
    logger.info("ingestor_shutdown_complete")


if __name__ == "__main__":
  ingestor = KiteBronzeIngestor()
  instruments = ingestor.sync_daily_instruments()

  # Example: subscribe NIFTY 50 (256265) & India VIX (264969) on Socket 1
  signal.signal(signal.SIGINT, lambda *_: ingestor.stop())
  ingestor.start(
      socket_1_index_tokens=[256265, 264969],
      socket_2_stock_opt_tokens=[],
      socket_3_nifty500_tokens=[],
  )
  while not ingestor._stop_event.is_set():
    time.sleep(1)
