from __future__ import annotations

from collections import deque
from datetime import datetime, timezone
import os
from pathlib import Path
import signal
import threading
import time
from typing import Any

import duckdb
from duckdb_extensions import import_extension
from kiteconnect import KiteConnect
from pydantic_settings import BaseSettings, SettingsConfigDict
import structlog

logger = structlog.get_logger(__name__)


class ExecutionSettings(BaseSettings):
  model_config = SettingsConfigDict(env_file=".env", extra="ignore")

  kite_api_key: str
  kite_access_token: str
  quack_uri: str = "quack:127.0.0.1:9494"
  quack_token: str = "local_secret"

  # Staleness SLAs (milliseconds)
  fresh_max_age_ms: int = 65_000  # 1m bar + 5s processing budget
  degraded_max_age_ms: int = 180_000  # 3m max before full kill switch

  # Kite Rate-Limit Safety Caps (buffered below 10/s, 400/m, 5000/day)
  max_orders_per_sec: int = 8
  max_orders_per_min: int = 350
  max_orders_per_day: int = 4500
  max_modifications_per_order: int = 20  # Kite hard cap is 25

  dry_run: bool = True  # Set False in .env for live order firing


class KiteRateLimiter:
  """
    Thread-safe sliding-window rate limiter enforcing Kite Connect's
    per-second, per-minute, and daily order placement quotas, plus per-order
    modification tracking.
    """

  def __init__(
      self,
      max_per_sec: int = 8,
      max_per_min: int = 350,
      max_per_day: int = 4500,
      max_mods: int = 20,
  ) -> None:
    self.max_per_sec = max_per_sec
    self.max_per_min = max_per_min
    self.max_per_day = max_per_day
    self.max_mods = max_mods

    self._sec_window: deque[float] = deque()
    self._min_window: deque[float] = deque()
    self._daily_count: int = 0
    self._mod_counts: dict[str, int] = {}
    self._lock = threading.Lock()

  def acquire_order_slot(self, timeout_sec: float = 2.0) -> bool:
    deadline = time.monotonic() + timeout_sec
    while time.monotonic() < deadline:
      with self._lock:
        now = time.monotonic()

        if self._daily_count >= self.max_per_day:
          logger.critical(
              "kite_daily_order_quota_exhausted", count=self._daily_count
          )
          return False

        while self._sec_window and (now - self._sec_window) >= 1.0:
          self._sec_window.popleft()
        while self._min_window and (now - self._min_window) >= 60.0:
          self._min_window.popleft()

        if (
            len(self._sec_window) < self.max_per_sec
            and len(self._min_window) < self.max_per_min
        ):
          self._sec_window.append(now)
          self._min_window.append(now)
          self._daily_count += 1
          return True

      time.sleep(0.02)

    logger.warning("kite_rate_limit_timeout")
    return False

  def can_modify_order(self, order_id: str) -> bool:
    with self._lock:
      count = self._mod_counts.get(order_id, 0)
      if count >= self.max_mods:
        return False
      self._mod_counts[order_id] = count + 1
      return True


class ExecutionRouter:
  """
    Live Strategy & Order Execution Engine (Process 4).
    Reads Gold artifacts exclusively from DuckDB 2.0 Quack server, applies
    staleness circuit-breakers and options regime sizing, and routes orders.
    """

  def __init__(self, settings: ExecutionSettings | None = None) -> None:
    self.settings = settings or ExecutionSettings()
    self.kite = KiteConnect(api_key=self.settings.kite_api_key)
    self.kite.set_access_token(self.settings.kite_access_token)
    self.limiter = KiteRateLimiter(
        max_per_sec=self.settings.max_orders_per_sec,
        max_per_min=self.settings.max_orders_per_min,
        max_per_day=self.settings.max_orders_per_day,
        max_mods=self.settings.max_modifications_per_order,
    )
    self._stop_event = threading.Event()
    self._kill_switch_engaged = False

    import_extension("quack")
    self.con = duckdb.connect(":memory:")
    self.con.execute("LOAD quack;")
    self._connect_quack()

  def _connect_quack(self) -> None:
    self.con.execute(
        f"CONNECT '{self.settings.quack_uri}' (TOKEN"
        f" '{self.settings.quack_token}');"
    )
    logger.info("execution_connected_to_quack", uri=self.settings.quack_uri)

  def fetch_latest_gold_state(self) -> tuple[str, dict[str, Any] | None]:
    """
        Reads the latest published Gold regime & feature snapshot from Quack
        and evaluates its age against staleness SLAs.
        Returns ('FRESH' | 'DEGRADED' | 'STALE' | 'MISSING', row_dict).
        """
    try:
      rel = self.con.sql("""
                SELECT *
                FROM gold_regime_latest
                ORDER BY published_at_utc DESC
                LIMIT 1
            """)
      df = rel.pl()
    except Exception as exc:
      logger.error("quack_read_failed", error=str(exc))
      return "MISSING", None

    if df.is_empty():
      return "MISSING", None

    row = df.row(0, named=True)
    pub_ts: datetime = row["published_at_utc"]
    if pub_ts.tzinfo is None:
      pub_ts = pub_ts.replace(tzinfo=timezone.utc)

    age_ms = int(
        (datetime.now(timezone.utc) - pub_ts).total_seconds() * 1000
    )

    if age_ms <= self.settings.fresh_max_age_ms:
      return "FRESH", row
    if age_ms <= self.settings.degraded_max_age_ms:
      return "DEGRADED", row
    return "STALE", row

  def engage_kill_switch(self, reason: str) -> None:
    if self._kill_switch_engaged:
      return
    self._kill_switch_engaged = True
    logger.critical("KILL_SWITCH_ENGAGED", reason=reason)

    if self.settings.dry_run:
      logger.warning("dry_run_kill_switch_simulated")
      return

    try:
      orders = self.kite.orders()
      for order in orders:
        if order.get("status") in ("OPEN", "TRIGGER PENDING"):
          self.kite.cancel_order(
              variety=order["variety"],
              order_id=order["order_id"],
          )
          logger.warning("cancelled_open_order", order_id=order["order_id"])
    except Exception as exc:
      logger.exception("kill_switch_cancel_failed", error=str(exc))

  def place_managed_order(
      self,
      tradingsymbol: str,
      exchange: str,
      transaction_type: str,
      base_quantity: int,
      lot_size: int,
      order_type: str,
      product: str,
      price: float | None = None,
      is_exit: bool = False,
      gold_state: dict[str, Any] | None = None,
  ) -> str | None:
    """
        Executes an entry or exit order after applying Hard Gate blocks,
        options-regime position sizing, and Kite rate-limit checks.
        """
    # 1. Entry Guardrails (Exits are always permitted unless kill switch is active)
    if not is_exit:
      if self._kill_switch_engaged:
        logger.warning("entry_blocked_kill_switch", symbol=tradingsymbol)
        return None
      if gold_state and gold_state.get("hard_gate_block_entries", False):
        logger.warning(
            "entry_blocked_options_hard_gate",
            symbol=tradingsymbol,
            vix=gold_state.get("india_vix"),
        )
        return None

      mult = float(
          gold_state.get("position_size_multiplier", 1.0)
          if gold_state
          else 1.0
      )
      scaled_qty = int((base_quantity * mult) // lot_size) * lot_size
      if scaled_qty <= 0:
        logger.info("entry_skipped_zero_scaled_qty", symbol=tradingsymbol)
        return None
    else:
      scaled_qty = base_quantity

    # 2. Enforce Kite Rate Limits
    if not self.limiter.acquire_order_slot():
      logger.error("order_dropped_rate_limit", symbol=tradingsymbol)
      return None

    # 3. Fire Order (or Log in Dry-Run Mode)
    if self.settings.dry_run:
      fake_id = f"DRY_{int(time.time() * 1000)}"
      logger.info(
          "dry_run_order_placed",
          order_id=fake_id,
          symbol=tradingsymbol,
          side=transaction_type,
          qty=scaled_qty,
          price=price,
      )
      return fake_id

    order_id = self.kite.place_order(
        variety=self.kite.VARIETY_REGULAR,
        exchange=exchange,
        tradingsymbol=tradingsymbol,
        transaction_type=transaction_type,
        quantity=scaled_qty,
        product=product,
        order_type=order_type,
        price=price,
    )
    logger.info(
        "live_order_placed",
        order_id=order_id,
        symbol=tradingsymbol,
        side=transaction_type,
        qty=scaled_qty,
    )
    return str(order_id)

  def run_loop(self, poll_interval_sec: float = 0.5) -> None:
    logger.info(
        "execution_router_started", dry_run=self.settings.dry_run
    )
    while not self._stop_event.is_set():
      status, gold = self.fetch_latest_gold_state()

      if status in ("STALE", "MISSING"):
        self.engage_kill_switch(reason=f"Gold state is {status}")
      elif status == "DEGRADED":
        logger.warning(
            "gold_state_degraded_entries_paused",
            regime=gold.get("regime_label") if gold else None,
        )
        # Allow exit/stop-loss management only; skip new entries
      elif status == "FRESH" and gold is not None:
        # Reset kill switch automatically once fresh Gold data resumes
        if self._kill_switch_engaged:
          logger.info("fresh_gold_restored_clearing_kill_switch")
          self._kill_switch_engaged = False

        # --- Plug your strategy signal evaluation here ---
        # Example: evaluate signals using `gold` and call `self.place_managed_order(...)`

      self._stop_event.wait(poll_interval_sec)

  def stop(self) -> None:
    self._stop_event.set()
    self.con.close()
    logger.info("execution_router_stopped")


