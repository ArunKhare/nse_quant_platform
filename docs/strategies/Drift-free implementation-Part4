from __future__ import annotations

from datetime import datetime, timezone
from typing import Any

import numpy as np
import polars as pl
import structlog

from quack_engine import QuackEngine

logger = structlog.get_logger(__name__)


class GoldRegimeAggregator:
  """
    Computes Gold-layer Market Breadth (NIFTY 500) and NIFTY Options Regime
    (ATM IV, IVR, PCR, Net Dealer GEX, Max Pain, and Risk-Adjustment / Hard-Gate flags)
    from Silver Parquet layers via DuckDB 2.0.
    """

  def __init__(self, quack: QuackEngine) -> None:
    self.quack = quack

  def compute_nifty500_breadth(
      self,
      bar_timestamp_utc: datetime,
      nifty500_tokens: list[int],
  ) -> dict[str, Any]:
    """
        Computes market-wide breadth across NIFTY 500 cash stocks at `bar_timestamp_utc`.
        Requires `silver_equity_1m` with columns: instrument_token, bar_timestamp_utc,
        close, prev_day_close, volume, ema_20, ema_50, ema_200.
        """
    if not nifty500_tokens:
      return {}

    ts_iso = bar_timestamp_utc.isoformat()
    tokens_csv = ",".join(str(int(t)) for t in nifty500_tokens)

    sql = f"""
            SELECT
                COUNT(*) AS total_stocks,
                SUM(CASE WHEN close > prev_day_close THEN 1 ELSE 0 END) AS advances,
                SUM(CASE WHEN close < prev_day_close THEN 1 ELSE 0 END) AS declines,
                SUM(CASE WHEN close > ema_20 THEN 1 ELSE 0 END) AS above_ema20,
                SUM(CASE WHEN close > ema_50 THEN 1 ELSE 0 END) AS above_ema50,
                SUM(CASE WHEN close > ema_200 THEN 1 ELSE 0 END) AS above_ema200,
                SUM(CASE WHEN close > prev_day_close THEN volume ELSE 0 END) AS up_volume,
                SUM(CASE WHEN close < prev_day_close THEN volume ELSE 0 END) AS down_volume
            FROM silver_equity_1m
            WHERE bar_timestamp_utc = TIMESTAMP '{ts_iso}'
              AND instrument_token IN ({tokens_csv})
        """
    df = self.quack.con.sql(sql).pl()
    if df.is_empty() or df["total_stocks"] == 0:
      return {}

    row = df.row(0, named=True)
    total = max(int(row["total_stocks"]), 1)
    declines = max(int(row["declines"]), 1)
    down_vol = max(float(row["down_volume"] or 0.0), 1.0)

    return {
        "breadth_universe_count": int(row["total_stocks"]),
        "advances": int(row["advances"]),
        "declines": int(row["declines"]),
        "ad_ratio": round(int(row["advances"]) / declines, 3),
        "pct_above_ema20": round(100.0 * int(row["above_ema20"]) / total, 2),
        "pct_above_ema50": round(100.0 * int(row["above_ema50"]) / total, 2),
        "pct_above_ema200": round(100.0 * int(row["above_ema200"]) / total, 2),
        "up_down_volume_ratio": round(
            float(row["up_volume"] or 0.0) / down_vol, 3
        ),
    }

  def compute_options_regime(
      self,
      underlying_name: str,
      nearest_expiry: str,
      bar_timestamp_utc: datetime,
      india_vix: float,
      vix_day_change_pct: float,
      trailing_1y_atm_ivs: list[float] | None = None,
  ) -> dict[str, Any]:
    """
        Computes ATM IV, IV Rank (IVR), PCR, Net Dealer GEX, Max Pain strike,
        and dynamic sizing / hard-gate circuit breakers for cash & options execution.
        """
    ts_iso = bar_timestamp_utc.isoformat()

    sql = f"""
            SELECT
                o.strike,
                o.option_type,
                o.oi,
                o.cum_volume,
                o.spot_close,
                o.iv_close,
                o.gamma,
                i.lot_size
            FROM silver_options_1m o
            JOIN bronze_instruments i
              ON o.instrument_token = i.instrument_token
            WHERE o.bar_timestamp_utc = TIMESTAMP '{ts_iso}'
              AND i.name = '{underlying_name}'
              AND i.expiry = '{nearest_expiry}'
              AND o.oi > 0
        """
    chain = self.quack.con.sql(sql).pl()
    if chain.is_empty():
      logger.warning(
          "empty_option_chain_for_gold",
          underlying=underlying_name,
          ts=ts_iso,
      )
      return {}

    spot = float(chain["spot_close"])

    # 1. ATM Strike & ATM IV (average of nearest CE & PE IV)
    atm_row = (
        chain.with_columns(
            (pl.col("strike") - spot).abs().alias("dist_to_spot")
        )
        .sort("dist_to_spot")
        .head(2)
    )
    atm_strike = float(atm_row["strike"])
    atm_iv = float(atm_row["iv_close"].drop_nulls().mean() or 0.0)

    # 2. IV Rank (IVR) against trailing 252-day ATM IV range
    ivr = 50.0
    if trailing_1y_atm_ivs and len(trailing_1y_atm_ivs) >= 10:
      iv_min = min(trailing_1y_atm_ivs)
      iv_max = max(trailing_1y_atm_ivs)
      if iv_max > iv_min:
        ivr = round(
            100.0 * np.clip((atm_iv - iv_min) / (iv_max - iv_min), 0.0, 1.0), 2
        )

    # 3. Put-Call Ratio (PCR) & Net Dealer Gamma Exposure (GEX in INR Crores)
    calls = chain.filter(pl.col("option_type") == "CE")
    puts = chain.filter(pl.col("option_type") == "PE")

    total_call_oi = float(calls["oi"].sum() or 0.0)
    total_put_oi = float(puts["oi"].sum() or 0.0)
    pcr_oi = round(total_put_oi / max(total_call_oi, 1.0), 3)

    # GEX per 1% spot move in INR Crores (1e7)
    call_gex = float(
        (
            calls["oi"]
            * calls["gamma"].fill_null(0.0)
            * calls["lot_size"]
            * (spot**2)
            * 0.01
        ).sum()
        or 0.0
    )
    put_gex = float(
        (
            puts["oi"]
            * puts["gamma"].fill_null(0.0)
            * puts["lot_size"]
            * (spot**2)
            * 0.01
        ).sum()
        or 0.0
    )
    net_gex_cr = round((call_gex - put_gex) / 1e7, 2)

    # 4. Vectorized Max Pain Calculation across all strikes
    strike_oi = (
        chain.group_by(["strike", "option_type"])
        .agg(pl.col("oi").sum())
        .pivot(on="option_type", index="strike", values="oi")
        .fill_null(0.0)
        .sort("strike")
    )
    strikes_arr = strike_oi["strike"].to_numpy()
    ce_oi_arr = (
        strike_oi["CE"].to_numpy()
        if "CE" in strike_oi.columns
        else np.zeros_like(strikes_arr)
    )
    pe_oi_arr = (
        strike_oi["PE"].to_numpy()
        if "PE" in strike_oi.columns
        else np.zeros_like(strikes_arr)
    )

    # Matrix [candidate_expiry_spot, strike]
    diff_matrix = strikes_arr[:, None] - strikes_arr[None, :]
    call_pain = np.maximum(diff_matrix, 0.0) @ ce_oi_arr
    put_pain = np.maximum(-diff_matrix, 0.0) @ pe_oi_arr
    max_pain_strike = float(strikes_arr[int(np.argmin(call_pain + put_pain))])

    # 5. Cash & Options Execution Regime Classification (Risk Adjustment vs Hard Gate)
    hard_gate_block_entries = (india_vix >= 24.0) or (vix_day_change_pct >= 15.0)

    if hard_gate_block_entries:
      regime_label = "TAIL_RISK_HARD_GATE"
      position_size_mult = 0.0
    elif india_vix >= 17.0 or net_gex_cr < 0.0:
      regime_label = "ELEVATED_VOL_NEGATIVE_GEX"
      position_size_mult = 0.50
    elif india_vix <= 14.0 and net_gex_cr > 0.0:
      regime_label = "CALM_POSITIVE_GEX"
      position_size_mult = 1.00
    else:
      regime_label = "NEUTRAL_BALANCED"
      position_size_mult = 0.75

    return {
        "underlying": underlying_name,
        "expiry": nearest_expiry,
        "spot_close": round(spot, 2),
        "atm_strike": atm_strike,
        "atm_iv_pct": round(atm_iv * 100.0, 2),
        "ivr": ivr,
        "india_vix": round(india_vix, 2),
        "vix_day_change_pct": round(vix_day_change_pct, 2),
        "pcr_oi": pcr_oi,
        "net_gex_cr": net_gex_cr,
        "max_pain_strike": max_pain_strike,
        "regime_label": regime_label,
        "position_size_multiplier": position_size_mult,
        "hard_gate_block_entries": hard_gate_block_entries,
    }

  def build_gold_snapshot(
      self,
      bar_timestamp_utc: datetime,
      nifty500_tokens: list[int],
      nearest_nifty_expiry: str,
      india_vix: float,
      vix_day_change_pct: float,
      trailing_1y_atm_ivs: list[float] | None = None,
  ) -> pl.DataFrame:
    """
        Combines NIFTY 500 Breadth + NIFTY Options Regime into a single Gold row
        ready for AtomicParquetWriter (`gold/regime_1m/...`) and Quack/Redis serving.
        """
    breadth = self.compute_nifty500_breadth(bar_timestamp_utc, nifty500_tokens)
    options_regime = self.compute_options_regime(
        underlying_name="NIFTY",
        nearest_expiry=nearest_nifty_expiry,
        bar_timestamp_utc=bar_timestamp_utc,
        india_vix=india_vix,
        vix_day_change_pct=vix_day_change_pct,
        trailing_1y_atm_ivs=trailing_1y_atm_ivs,
    )

    snapshot = {
        "bar_timestamp_utc": bar_timestamp_utc,
        "published_at_utc": datetime.now(timezone.utc),
        **breadth,
        **options_regime,
    }
    return pl.DataFrame([snapshot])
