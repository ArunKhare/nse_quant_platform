
1. Why "Catalog-Over-Parquet" is Mandatory on Windows 11 (and Ubuntu)

In a multi-process trading platform (Ingestor, Normalizer, Gold Builder, Dash UI, VectorBT Backtester), never open a single .duckdb file in read/write mode across multiple processes, as Windows enforces strict file locking (IO Error: Cannot open file).
Instead, use the In-Memory DuckDB + Immutable Parquet architecture:
• Single Writer (AtomicParquetWriter): Writes Hive-partitioned .parquet files to data/bronze/, data/silver/, and data/gold/ using same-volume temp files and os.replace().
• Multi-Reader (QuackEngine): Every process opens an isolated :memory: DuckDB session with a disk spill folder (tmp_duckdb) and creates SQL views over your Parquet files. Multiple processes can query concurrently with zero lock contention.

2. Complete quack_engine.py

Save this file in your project root. It uses POSIX forward slashes (.as_posix()) inside SQL strings so every query runs identically on Windows 11 NTFS today and Ubuntu 24.04 LTS later:
python
from __future__ import annotations

import os
from pathlib import Path
from typing import Any

import duckdb
import polars as pl
from pydantic_settings import BaseSettings, SettingsConfigDict
import structlog

logger = structlog.get_logger(__name__)


class QuackSettings(BaseSettings):
  model_config = SettingsConfigDict(env_file=".env", extra="ignore")

  trading_data_root: Path = Path(
      r"C:\trading_platform" if os.name == "nt" else "/srv/trading_platform"
  )
  duckdb_memory_limit: str = "12GB"  # Leaves 20GB headroom on your 32GB machine
  duckdb_threads: int = max(2, (os.cpu_count() or 4) - 2)


class QuackEngine:
  """
    Multi-process safe DuckDB analytical engine ('Quack') over Medallion Parquet storage.
    Uses an in-memory DuckDB catalog + SSD spill directory + Hive-partitioned Parquet views
    so Dash UI, VectorBT backtests, and Silver/Gold workers run concurrently on Windows 11
    and Ubuntu Linux without file-lock collisions.
    """

  def __init__(self, settings: QuackSettings | None = None) -> None:
    self.settings = settings or QuackSettings()
    self.data_dir = self.settings.trading_data_root / "data"
    self.temp_dir = self.settings.trading_data_root / "tmp_duckdb"
    self.temp_dir.mkdir(parents=True, exist_ok=True)

    # Always connect :memory: so concurrent processes never lock a shared .duckdb file
    self.con = duckdb.connect(database=":memory:")
    self._configure_engine()
    self.refresh_views()

  def _configure_engine(self) -> None:
    temp_posix = self.temp_dir.as_posix()
    self.con.execute(f"SET memory_limit = '{self.settings.duckdb_memory_limit}';")
    self.con.execute(f"SET threads = {self.settings.duckdb_threads};")
    self.con.execute(f"SET temp_directory = '{temp_posix}';")
    self.con.execute("SET preserve_insertion_order = false;")

  def refresh_views(self) -> list[str]:
    """
        Registers SQL views over any Medallion layer that currently contains Parquet files.
        Call periodically in Dash or long-running processes to pick up newly flushed files.
        """
    layer_specs: dict[str, tuple[Path, str]] = {
        "bronze_ticks": (
            self.data_dir / "bronze",
            "*/ticks_*.parquet",
        ),
        "bronze_instruments": (
            self.data_dir / "bronze",
            "*/instruments.parquet",
        ),
        "silver_equity_1m": (
            self.data_dir / "silver" / "equity_1m",
            "**/*.parquet",
        ),
        "silver_options_1m": (
            self.data_dir / "silver" / "options_1m",
            "**/*.parquet",
        ),
        "gold_regime_1m": (
            self.data_dir / "gold" / "regime_1m",
            "**/*.parquet",
        ),
    }

    registered: list[str] = []
    for view_name, (base_folder, pattern) in layer_specs.items():
      if base_folder.exists() and any(base_folder.rglob("*.parquet")):
        glob_posix = (base_folder / pattern).as_posix()
        self.con.execute(f"""
                    CREATE OR REPLACE VIEW {view_name} AS
                    SELECT *
                    FROM read_parquet('{glob_posix}', hive_partitioning=true, union_by_name=true);
                """)
        registered.append(view_name)

    logger.info("quack_views_refreshed", views=registered)
    return registered

  def query_polars(
      self, sql: str, params: list[Any] | None = None
  ) -> pl.DataFrame:
    """
        Executes SQL and returns a zero-copy Polars DataFrame via Apache Arrow.
        """
    relation = (
        self.con.execute(sql, params)
        if params is not None
        else self.con.execute(sql)
    )
    return pl.from_arrow(relation.arrow())

  def asof_join_options_to_spot(
      self,
      trade_date: str,
      underlying_token: int,
      max_staleness_ms: int = 2000,
  ) -> pl.DataFrame:
    """
        Point-in-time ASOF JOIN matching each option tick to the latest known
        underlying spot price at or before the option timestamp.
        """
    day_dir = self.data_dir / "bronze" / trade_date
    if not day_dir.exists() or not any(day_dir.glob("ticks_*.parquet")):
      logger.warning("no_bronze_ticks_found", trade_date=trade_date)
      return pl.DataFrame()

    bronze_glob = (day_dir / "ticks_*.parquet").as_posix()
    sql = """
            WITH raw_ticks AS (
                SELECT * FROM read_parquet(?, union_by_name=true)
            ),
            spot AS (
                SELECT
                    exchange_ts_ms AS spot_ts_ms,
                    last_price AS spot_price
                FROM raw_ticks
                WHERE instrument_token = ?
                ORDER BY exchange_ts_ms
            ),
            opts AS (
                SELECT *
                FROM raw_ticks
                WHERE instrument_token != ?
                ORDER BY exchange_ts_ms
            )
            SELECT
                o.*,
                s.spot_price,
                (o.exchange_ts_ms - s.spot_ts_ms) AS spot_staleness_ms
            FROM opts o
            ASOF JOIN spot s
              ON o.exchange_ts_ms >= s.spot_ts_ms
            WHERE (o.exchange_ts_ms - s.spot_ts_ms) <= ?
        """
    return self.query_polars(
        sql,
        [bronze_glob, underlying_token, underlying_token, max_staleness_ms],
    )

  def close(self) -> None:
    self.con.close()

  def __enter__(self) -> QuackEngine:
    return self

  def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None:
    self.close()
