Use a vectorized Newton-Raphson solver with bisection fallback (numpy + scipy.special.ndtr + polars) over synthetic forward prices (\(F = S \cdot e^{rT}\)) to compute Black-76 Implied Volatility and Greeks across tens of thousands of option rows in milliseconds.
Using scipy.special.ndtr instead of scipy.stats.norm.cdf avoids Python object overhead and executes directly in compiled C over contiguous NumPy arrays.

1. Mathematical & NSE Market Conventions

1. Synthetic Forward Price (F): For European index and stock options on NSE (where options are priced off spot S, or directly off concurrent futures F if available):
\(F=S\cdot e^{r\cdot T}\)
(Using F in Black-76 avoids dividend-yield estimation errors on weekly/monthly options and matches exchange risk-engine pricing).
2. Time to Expiry (T): Compute exact remaining seconds down to 15:30:00 IST (10:00:00 UTC) on the expiry date divided by 31,536,000 (365 * 86400), floored at 1e-6 (~31 seconds) to avoid division-by-zero on expiry afternoon.
3. NSE Standardized Outputs:
	• Theta: Reported as daily decay (\(\Theta_{\text{annual}} / 365\)).
	• Vega: Reported per 1% change in IV (\(\mathcal{V} / 100\)).

2. Complete black76_greeks.py

Save this module in your Silver processing package. It accepts the pl.DataFrame returned by asof_join_options_to_spot() (joined with strike, expiry_ts_ms, and option_type (CE/PE) from your instrument master) and outputs the enriched silver_options_1m DataFrame:
python
from __future__ import annotations

import numpy as np
from numpy.typing import NDArray
import polars as pl
from scipy.special import ndtr

INV_SQRT_2PI: float = 0.3989422804014327
SECONDS_PER_YEAR: float = 365.0 * 86_400.0


def _norm_pdf(x: NDArray[np.float64]) -> NDArray[np.float64]:
  return INV_SQRT_2PI * np.exp(-0.5 * x * x)


def black76_price_and_vega(
    forward: NDArray[np.float64],
    strike: NDArray[np.float64],
    tte: NDArray[np.float64],
    rate: float,
    sigma: NDArray[np.float64],
    is_call: NDArray[np.bool_],
) -> tuple[NDArray[np.float64], NDArray[np.float64]]:
  """
    Vectorized Black-76 option theoretical price and annual vega.
    """
  sqrt_t = np.sqrt(tte)
  vol_sqrt_t = np.maximum(sigma * sqrt_t, 1e-12)
  df = np.exp(-rate * tte)

  d1 = (np.log(forward / strike) + 0.5 * sigma * sigma * tte) / vol_sqrt_t
  d2 = d1 - vol_sqrt_t

  sign = np.where(is_call, 1.0, -1.0)
  price = df * sign * (forward * ndtr(sign * d1) - strike * ndtr(sign * d2))
  vega_annual = df * forward * _norm_pdf(d1) * sqrt_t
  return price, vega_annual


def solve_iv_vectorized(
    market_price: NDArray[np.float64],
    forward: NDArray[np.float64],
    strike: NDArray[np.float64],
    tte: NDArray[np.float64],
    rate: float,
    is_call: NDArray[np.bool_],
    max_iter: int = 35,
    tol: float = 1e-6,
) -> NDArray[np.float64]:
  """
    Hybrid vectorized Newton-Raphson + Bisection Implied Volatility solver.
    Returns NaN for deep ITM/OTM options violating no-arbitrage intrinsic bounds.
    """
  n = len(market_price)
  df = np.exp(-rate * tte)
  intrinsic = df * np.maximum(
      np.where(is_call, forward - strike, strike - forward), 0.0
  )

  # Valid arbitrage bounds: intrinsic < market_price < discounted forward/strike
  upper_bound = df * np.where(is_call, forward, strike)
  valid = (
      (market_price > intrinsic + 1e-4)
      & (market_price < upper_bound)
      & (tte > 0.0)
  )

  iv = np.full(n, np.nan, dtype=np.float64)
  if not np.any(valid):
    return iv

  p_v = market_price[valid]
  f_v = forward[valid]
  k_v = strike[valid]
  t_v = tte[valid]
  c_v = is_call[valid]

  # Bracket bounds [0.1% IV, 500% IV]
  low = np.full(len(p_v), 0.001, dtype=np.float64)
  high = np.full(len(p_v), 5.000, dtype=np.float64)

  # Brenner-Subrahmanyam ATM initial guess clipped inside [low, high]
  sigma = np.clip(
      np.sqrt(2.0 * np.pi / t_v) * (p_v / f_v),
      0.05,
      2.50,
  )

  for _ in range(max_iter):
    price, vega = black76_price_and_vega(f_v, k_v, t_v, rate, sigma, c_v)
    diff = price - p_v

    if np.max(np.abs(diff)) < tol:
      break

    # Update bisection brackets strictly
    low = np.where(diff < 0.0, sigma, low)
    high = np.where(diff > 0.0, sigma, high)

    # Newton step where vega is well-conditioned; otherwise midpoint bisection
    use_newton = vega > 1e-5
    newton_step = np.where(use_newton, sigma - diff / np.maximum(vega, 1e-8), 0.0)
    in_bracket = (newton_step > low) & (newton_step < high) & use_newton

    sigma = np.where(in_bracket, newton_step, 0.5 * (low + high))

  iv[valid] = sigma
  return iv


def compute_silver_options_greeks(
    joined_df: pl.DataFrame,
    risk_free_rate: float = 0.065,  # ~6.5% RBI 91-day T-Bill yield
) -> pl.DataFrame:
  """
    Transforms `asof_join_options_to_spot()` output (enriched with strike, expiry_ts_ms,
    and option_type) into Silver-layer option analytics with IV and Black-76 Greeks.

    Required columns in `joined_df`:
      - instrument_token, exchange_ts_ms, last_price (option price), spot_price
      - strike, expiry_ts_ms (15:30 IST on expiry day in epoch ms), option_type ('CE' or 'PE')
    """
  if joined_df.is_empty():
    return joined_df

  # 1. Compute Time-to-Expiry (T) and Synthetic Forward (F) in Polars
  df = joined_df.with_columns(
      (
          (pl.col("expiry_ts_ms") - pl.col("exchange_ts_ms"))
          / (SECONDS_PER_YEAR * 1000.0)
      )
      .clip(lower_bound=1e-6)
      .alias("tte"),
  ).with_columns(
      (
          pl.col("spot_price")
          * (pl.lit(risk_free_rate) * pl.col("tte")).exp()
      ).alias("forward_price"),
      ((pl.col("spot_price") - pl.col("strike")) / pl.col("strike")).alias(
          "moneyness_pct"
      ),
  )

  # 2. Extract contiguous float64 NumPy arrays
  market_price = df["last_price"].to_numpy().astype(np.float64)
  forward = df["forward_price"].to_numpy().astype(np.float64)
  strike = df["strike"].to_numpy().astype(np.float64)
  tte = df["tte"].to_numpy().astype(np.float64)
  is_call = (df["option_type"] == "CE").to_numpy()

  # 3. Solve Implied Volatility
  iv = solve_iv_vectorized(
      market_price=market_price,
      forward=forward,
      strike=strike,
      tte=tte,
      rate=risk_free_rate,
      is_call=is_call,
  )

  # 4. Compute Black-76 Greeks using solved IV
  sqrt_t = np.sqrt(tte)
  vol_sqrt_t = iv * sqrt_t
  disc = np.exp(-risk_free_rate * tte)

  d1 = (np.log(forward / strike) + 0.5 * iv * iv * tte) / vol_sqrt_t
  d2 = d1 - vol_sqrt_t
  pdf_d1 = _norm_pdf(d1)

  delta = np.where(is_call, disc * ndtr(d1), -disc * ndtr(-d1))
  gamma = (disc * pdf_d1) / (forward * vol_sqrt_t)
  vega_pct = (disc * forward * pdf_d1 * sqrt_t) / 100.0  # Per 1% IV move

  # Black-76 Theta (per calendar day)
  term1 = -(disc * forward * pdf_d1 * iv) / (2.0 * sqrt_t)
  call_theta = term1 - risk_free_rate * disc * (
      strike * ndtr(d2) - forward * ndtr(d1)
  )
  put_theta = term1 + risk_free_rate * disc * (
      strike * ndtr(-d2) - forward * ndtr(-d1)
  )
  theta_daily = np.where(is_call, call_theta, put_theta) / 365.0

  # 5. Attach Silver columns back to Polars DataFrame
  return df.with_columns(
      pl.Series("iv", iv),
      pl.Series("delta", delta),
      pl.Series("gamma", gamma),
      pl.Series("theta_daily", theta_daily),
      pl.Series("vega_pct", vega_pct),
  )
